# WebRAG environment configuration.
# Copy this file to .env and fill in the values you need. Nothing here is a
# real secret. See app/config.py for the full Settings model.

APP_ENV=development

# --- LLM (required for chat/research/compare/summarize/extract endpoints) ---
# Provider used for grounded chat generation. One of: openai, gemini.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Set the key for whichever LLM_PROVIDER you choose above.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Embeddings ---
# "local" works fully offline (sentence-transformers), no API key needed.
# Set to "openai" or "gemini" to use a cloud embedding model instead.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Reranker ---
# "local" (cross-encoder, offline) or "lexical" (pure heuristic fallback).
RERANKER_PROVIDER=local

# --- Crawler ---
MAX_CRAWL_PAGES=50
MAX_CRAWL_DEPTH=3
REQUEST_TIMEOUT=10.0
CRAWL_RATE_LIMIT_PER_SEC=2.0
MAX_RESPONSE_BYTES=5000000

# --- Storage ---
STORAGE_PATH=storage

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
